<?xml version="1.0"?>
<ruleset name="Photo Competition Manager">
	<description>PHP CodeSniffer configuration for Photo Competition Manager</description>

	<!-- Check all PHP files in src directory -->
	<file>./src</file>

	<!-- Exclude build directory (auto-generated files) -->
	<exclude-pattern>*/assets/build/*</exclude-pattern>

	<!-- Exclude dev-only CLI helpers (not shipped; see .releaseignore) -->
	<exclude-pattern>*/src/scripts/*</exclude-pattern>

	<!-- Errors block CI; warnings are informational and do not fail the build. -->
	<config name="ignore_warnings_on_exit" value="1"/>

	<!-- Use WordPress coding standards -->
	<rule ref="WordPress">
		<!-- Allow custom capabilities -->
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_photo_competitions"/>
			</property>
		</properties>
	</rule>

	<!-- Configure plugin prefix for namespace validation -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="PhotoCompetitionManager"/>
				<element value="photo_competition_manager"/>
			</property>
		</properties>
		<!-- Template partials hold include-scoped locals, not true globals. -->
		<exclude-pattern>*/src/templates/*</exclude-pattern>
	</rule>

	<!-- Show progress and colors -->
	<arg value="ps"/>
	<arg name="colors"/>

	<!-- Check PHP files only -->
	<arg name="extensions" value="php"/>
</ruleset>
