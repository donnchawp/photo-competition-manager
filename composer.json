{
    "name": "photo/competition-manager",
    "description": "WordPress plugin for managing photography competitions.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {},
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.0",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "PhotoCompetitionManager\\": [
                "src/includes/",
                "src/admin/",
                "src/public/"
            ],
            "PhotoCompetitionManager\\Support\\": "src/includes/Support/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhotoCompetitionManager\\Tests\\": "tests/phpunit/"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
