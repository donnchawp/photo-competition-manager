{
    "name": "club/competitions",
    "description": "WordPress plugin for photography club competitions.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {},
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.0",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ClubCompetitions\\": [
                "club-competitions/includes/",
                "club-competitions/admin/",
                "club-competitions/public/"
            ],
            "ClubCompetitions\\Support\\": "club-competitions/includes/Support/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ClubCompetitions\\Tests\\": "tests/phpunit/"
        }
    },
    "scripts": {
        "lint": "phpcs --standard=WordPress --extensions=php club-competitions",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
